<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EyeGuard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#12644A</item>
        <item name="colorPrimaryVariant">#0E4C38</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowBackground">#F6FAF8</item>
        <item name="android:statusBarColor">#F6FAF8</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.EyeGuard.Break" parent="Theme.EyeGuard">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#0B1F19</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 启动页：深绿底 + logo，进入主界面后切回正常主题 -->
    <style name="Theme.EyeGuard.Splash" parent="Theme.EyeGuard">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/brand_deep</item>
        <item name="android:navigationBarColor">@color/brand_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
